{
  "artifact_types": [
    {
      "artifact_type": "compose",
      "parser_id": "compose",
      "basename": ["docker-compose.yml", "docker-compose.yaml", "compose.yml", "compose.yaml"],
      "basename_prefix": ["docker-compose."],
      "basename_suffix": [".yml", ".yaml"]
    },
    {
      "artifact_type": "appsettings",
      "parser_id": "appsettings",
      "path_glob": ["appsettings*.json", "**/appsettings*.json", "**/.env", "**/example.env"]
    },
    {
      "artifact_type": "openapi",
      "parser_id": "openapi",
      "path_glob": ["**/openapi*.yml", "**/openapi*.yaml", "**/contracts/swagger/**"]
    },
    {
      "artifact_type": "dotnet-project",
      "parser_id": "dotnet-project",
      "path_suffix": [".sln", ".csproj"]
    },
    {
      "artifact_type": "ts-api-routes",
      "parser_id": "ts-api-routes",
      "path_suffix": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs"],
      "content_hints": ["fastify"]
    },
    {
      "artifact_type": "dotnet-api-routes",
      "parser_id": "dotnet-api-routes",
      "path_suffix": [".cs"],
      "content_hints": ["[HttpGet", "[HttpPost", "[HttpPut", "[HttpDelete", "[Route", "MapGet", "MapPost", "MapPut", "MapDelete"]
    },
    {
      "artifact_type": "ts-http-calls",
      "parser_id": "ts-http-calls",
      "path_suffix": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs"],
      "content_hints": ["apiFetch", "API_BASE", "'/api/v1'", "\"/api/v1\""]
    },
    {
      "artifact_type": "grpc-proto",
      "parser_id": "grpc-proto",
      "path_suffix": [".proto"],
      "content_hints": ["syntax = \"proto3\"", "service ", "rpc "]
    },
    {
      "artifact_type": "ts-grpc-calls",
      "parser_id": "ts-grpc-calls",
      "path_suffix": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs"],
      "content_hints": ["grpc", "Client", "UnaryCall"]
    },
    {
      "artifact_type": "maven-project",
      "parser_id": "maven-project",
      "basename": ["pom.xml"]
    },
    {
      "artifact_type": "gradle-project",
      "parser_id": "gradle-project",
      "basename": ["build.gradle", "build.gradle.kts"]
    },
    {
      "artifact_type": "spring-config",
      "parser_id": "spring-config",
      "path_glob": ["application*.yml", "application*.yaml", "application*.properties", "**/application*.yml", "**/application*.yaml", "**/application*.properties"]
    },
    {
      "artifact_type": "java-api-routes",
      "parser_id": "java-api-routes",
      "path_suffix": [".java", ".yml", ".yaml"],
      "content_hints": ["@RestController", "@Controller", "@RequestMapping", "@GetMapping", "@PostMapping", "RouterFunction", "Path=", "spring.cloud.gateway"]
    },
    {
      "artifact_type": "java-http-calls",
      "parser_id": "java-http-calls",
      "path_suffix": [".java"],
      "content_hints": ["@FeignClient", "WebClient", "webClient.", "RestClient", "RestTemplate", "HttpURLConnection"]
    },
    {
      "artifact_type": "java-grpc-calls",
      "parser_id": "java-grpc-calls",
      "path_suffix": [".java"],
      "content_hints": ["ManagedChannelBuilder", "newBlockingStub", "newFutureStub"]
    },
    {
      "artifact_type": "dotnet-grpc-calls",
      "parser_id": "dotnet-grpc-calls",
      "path_suffix": [".cs"],
      "content_hints": ["GrpcChannel.ForAddress", "ClientBase", ".GrpcClient"]
    },
    {
      "artifact_type": "dotnet-http-calls",
      "parser_id": "dotnet-http-calls",
      "path_suffix": [".cs"],
      "content_hints": ["HttpClient", "GetAsync(", "PostAsync(", "PutAsync(", "DeleteAsync("]
    },
    {
      "artifact_type": "frontend-ui",
      "parser_id": "react-ui",
      "custom_detection": true
    },
    {
      "artifact_type": "frontend-angular",
      "parser_id": "angular-ui",
      "custom_detection": true
    },
    {
      "artifact_type": "frontend-angularjs",
      "parser_id": "angularjs-ui",
      "custom_detection": true
    },
    {
      "artifact_type": "python-api-routes",
      "parser_id": "python-api-routes",
      "path_suffix": [".py", ".pyw"],
      "content_hints": [
        "FastAPI",
        "@app.",
        "APIRouter",
        "Flask",
        "@app.route",
        "urlpatterns",
        "django.urls"
      ]
    },
    {
      "artifact_type": "python-http-calls",
      "parser_id": "python-http-calls",
      "path_suffix": [".py", ".pyw"],
      "content_hints": ["httpx", "requests.", "aiohttp"]
    },
    {
      "artifact_type": "python-grpc-calls",
      "parser_id": "python-grpc-calls",
      "path_suffix": [".py", ".pyw"],
      "content_hints": ["grpc", "grpcio", "pb2_grpc", "Stub(", "insecure_channel"]
    }
  ],
  "bus": {
    "rabbit": {
      "appsettings_keys": ["RabbitMQ", "MassTransit"],
      "csproj_packages": ["RabbitMQ.Client", "MassTransit.RabbitMQ"],
      "maven_packages": ["spring-boot-starter-amqp", "spring-rabbit"],
      "cs_content_hints": ["IConsumer", "ReceiveEndpoint", "RabbitMQ"],
      "java_content_hints": ["@RabbitListener", "RabbitTemplate", "AmqpTemplate"]
    },
    "kafka": {
      "appsettings_keys": ["Kafka", "BootstrapServers", "AddKafka"],
      "csproj_packages": ["Confluent.Kafka", "MassTransit.Kafka"],
      "maven_packages": ["spring-kafka", "spring-boot-starter-kafka"],
      "cs_content_hints": ["IConsumer", "Topic(", "AddKafka"],
      "java_content_hints": ["@KafkaListener", "KafkaTemplate"]
    }
  }
}
