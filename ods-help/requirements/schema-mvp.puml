@startuml schema-final
skinparam shadowing false
skinparam componentStyle rectangle
skinparam defaultTextAlignment center
skinparam wrapWidth 220
skinparam ArrowColor #444444
skinparam RectangleBorderColor #444444

title ODS MVP портал (001-ods-vision)\nреализация по spec/plan/tasks — этап 0

actor "Пользователь\nразработчик / архитектор\n(без входа в MVP)" as user

cloud "Источник проекта\nGit URL или локальный путь" as git

rectangle "Docker Compose — apps/ods-portal" #F9F9F9 {

  component "portal-ui\n[React 19 / Vite]\nдерево, редактор,\nдокументация, статусы" as ui

  component "portal-api\n[Node 22 / Fastify]\nHTTP API /api/v1\nбез auth middleware" as api

  folder "Рабочая копия\n/workspace/repos/{project_id}\nсодержимое текстовых файлов" as ws

  database "Elasticsearch\n(single-node)" as es

  together {
    component "portal-projects" as idx_proj #E8F8E8
    component "portal-elements\n(дерево, статусы, hash)" as idx_el #E8F8E8
    component "portal-sync-jobs" as idx_sync #E8F8E8
    component "portal-document-links" as idx_links #E8F8E8
  }

  es -[hidden]down- idx_proj
}

rectangle "Post-MVP (вне scope 001,\nтот же Elasticsearch позже)" #EEEEEE {

  component "Graphify CLI\n[отдельный процесс,\nсвой JSON]" as graphify #E8F4FF

  folder "Graphify Out\n/workspace/graphify-out/{project_id}" as gout

  component "Roslyn / парсеры\nканал языкового анализа" as parsers #EEEEEE

  together {
    component "nodes" as idx_nodes #F0F0F0
    component "edges" as idx_edges #F0F0F0
    component "files" as idx_files #F0F0F0
  }

  database "Elasticsearch\n(те же индексы)" as es_future
}

user --> ui : просмотр, правка,\nнавигация, статусы
ui --> api : HTTP (без Authorization)

api --> git : clone / fetch\n(без push/merge)
api --> ws : read / write файлов\nсоздание, сохранение
api --> ws : scan → sync\n(обход дерева)
api --> es : CRUD метаданных\nportal-*

ws ..> idx_el : content_hash\nна диске
idx_links ..> idx_el : document ↔ code

graphify ..> ws : post-MVP:\nчитает репозиторий
graphify ..> gout : graph.json
parsers ..> ws : post-MVP:\nAST / модель
api ..> graphify : post-MVP:\nspawn subprocess
api ..> gout : post-MVP:\nadapter → ES
api ..> es_future : post-MVP:\nnodes, edges, files

note bottom of api
  **MVP (FR-001–011):**
  • регистрация проекта (/admin — метка экрана)
  • sync → portal-elements (status auto_discovered)
  • редактор + конфликт hash (409)
  • раздел «Документация», связи в portal-document-links

  **Не в MVP:** Graphify, граф, RAG,
  эмбеддинги, вход, Git push/merge.
end note

note right of es
  **Только Elasticsearch.**
  MVP: portal-* индексы.
  Post-MVP: nodes, edges, files.

  PostgreSQL, ChromaDB,
  векторный поиск — **не используются**
  (spec v1.5.0).
end note

@enduml
