@startuml schema
skinparam shadowing false
skinparam componentStyle rectangle
skinparam defaultTextAlignment center
skinparam wrapWidth 200
skinparam ArrowColor #444444
skinparam RectangleBorderColor #444444

title ODS MVP - анализ кода и граф проекта

actor "Пользователь\nразработчик / архитектор" as user

cloud "Git-репозиторий\nURL или локальный путь" as git

rectangle "ODS (одна поставка: образ / compose)" #F9F9F9 {

  component "Web UI\n[TypeScript / React]" as ui

  component "ODS Service\nоркестратор, API,\nпарсеры, адаптеры" as svc

  component "Graphify CLI\n[встроен в образ ODS]\nотдельный процесс,\nсвой JSON" as graphify #E8F4FF

  folder "Working Copy\n/workspace/repos/<repo_id>" as ws

  folder "Graphify Out\n/workspace/graphify-out/<repo_id>" as gout

  database "Elasticsearch\nnodes, edges, files" as es
}

user --> ui : просмотр, навигация
ui --> svc : HTTP API
svc --> git : clone / fetch / diff
svc --> ws : sync, парсеры читают файлы
svc --> graphify : spawn subprocess
graphify --> ws : читает репозиторий
graphify --> gout : graph.json
svc --> gout : читает JSON
svc --> es : unified graph / индексация

note bottom of graphify
  Логически отдельный инструмент.
  Физически - часть установки ODS.
  Не библиотека внутри Service.
  MVP: вариант A - CLI в том же контейнере.
  Альтернатива B - sidecar + общие volumes.
end note

note right of svc
  Канал 1: Roslyn / TS API
  -> extract model -> unified graph

  Канал 2: Graphify adapter
  -> Graphify JSON -> UI / ES

  PostgreSQL, ChromaDB - на оценку
  (этапы 1 и 7).
end note

@enduml
