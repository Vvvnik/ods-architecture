@startuml schema
skinparam shadowing false
skinparam componentStyle rectangle
skinparam defaultTextAlignment center
skinparam wrapWidth 200
skinparam ArrowColor #444444
skinparam RectangleBorderColor #444444

title ODS MVP - анализ кода и граф проекта

actor "Пользователь\nразработчик / архитектор" as user

cloud "Git-репозиторий\nURL или локальный путь" as git

rectangle "ODS (одна поставка: образ / compose)" #F9F9F9 {

  component "Web UI\n[TypeScript / React]" as ui

  component "ODS Service\nоркестратор, API,\nпарсеры, ingest" as svc

  component "Parser CLIs\n[TS / C# / Python / C++]\nотдельные subprocess" as parsers #EEEEEE

  folder "Working Copy\n/workspace/repos/<repo_id>" as ws

  database "Elasticsearch\ngraph_nodes, graph_edges,\nanalysis_runs, envelopes" as es
}

user --> ui : просмотр, навигация
ui --> svc : HTTP API
svc --> git : clone / fetch / diff
svc --> ws : sync, парсеры читают файлы
svc --> parsers : spawn subprocess
parsers --> ws : читает файлы
parsers --> svc : envelope JSON
svc --> es : ingest → канон графа

note bottom of parsers
  Модульный парсер на язык.
  Envelope + native model.
  Не библиотека внутри Service.
  MVP: CLI в том же контейнере.
  Альтернатива — sidecar + общие volumes.
end note

note right of svc
  005: Detector → отчёт по языкам
  → UX (2 окна) → парсеры
  006: Ingest adapters → канон ES
  → API + UI «Граф»

  PostgreSQL, ChromaDB — на оценку
  (этапы 1 и 10).
end note

@enduml
