{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ods.local/ods-help/json-model/native-appsettings",
  "title": "Native Model — appsettings parser",
  "description": "parser_id=appsettings, schema_version=1. Connection strings, bus, URLs from JSON/env.",
  "implementation_status": "done",
  "spec": "009-system-landscape",
  "type": "object",
  "required": ["sources"],
  "properties": {
    "sources": {
      "type": "array",
      "description": "One element per appsettings*.json, .env or example.env",
      "items": {
        "type": "object",
        "required": ["path", "bindings"],
        "properties": {
          "path": {
            "type": "string",
            "description": "POSIX-path to config-file in WC"
          },
          "environment": {
            "type": "string",
            "description": "Environment name from filename: Development, Production, Preprod, …"
          },
          "service_hint": {
            "type": "string",
            "description": "Heuristic logical service from path: Sample.Api, billing, …"
          },
          "bindings": {
            "type": "array",
            "description": "Extracted bindings to external systems from key/value config",
            "items": {
              "type": "object",
              "required": ["key", "binding_type"],
              "properties": {
                "key": {
                  "type": "string",
                  "description": "Configuration key: ConnectionStrings__DefaultConnection, KafkaEndpoint, …"
                },
                "binding_type": {
                  "type": "string",
                  "enum": ["database", "broker", "cache", "storage", "http_base_url", "search", "other"],
                  "description": "Binding class for ingest (connects_to, http_calls)"
                },
                "engine": {
                  "type": "string",
                  "description": "Engine/technology: postgres, mssql, kafka, redis, minio, couchdb, …"
                },
                "target_hint": {
                  "type": "string",
                  "description": "host:port or logical name without credentials"
                },
                "raw_redacted": {
                  "type": "string",
                  "description": "Value with password/token replacement to ***"
                }
              }
            }
          }
        }
      }
    }
  }
}
