{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ods.local/ods-help/json-model/native-symbols-v1",
  "title": "Native Symbols Model v1",
  "description": "Native model for typescript, csharp, python, cpp (schema_version 1). Implemented in parsers/*.",
  "implementation_status": "implemented",
  "spec": "005-code-analysis / 006-project-graph",
  "type": "object",
  "required": ["symbols"],
  "properties": {
    "symbols": {
      "type": "array",
      "description": "Flat list of file symbols and nested entities",
      "items": { "$ref": "#/$defs/Symbol" }
    }
  },
  "$defs": {
    "Location": {
      "type": "object",
      "description": "Position in source (1-based line)",
      "properties": {
        "start_line": { "type": "integer", "minimum": 1, "description": "Start line" },
        "start_col": { "type": "integer", "minimum": 0, "description": "Start column" },
        "end_line": { "type": "integer", "minimum": 1, "description": "End line" },
        "end_col": { "type": "integer", "minimum": 0, "description": "End column" }
      }
    },
    "SymbolRef": {
      "type": "object",
      "description": "Link from symbol to another symbol or namespace",
      "required": ["type", "name"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["imports", "exports", "inherits", "implements"],
          "description": "Connection type at native model v1 (calls — only in v2)"
        },
        "name": { "type": "string", "description": "Short target name" },
        "kind": { "type": "string", "description": "Target kind, if known" },
        "path": { "type": "string", "description": "POSIX path of target file, if resolved" },
        "qualified_name": { "type": "string", "description": "Target FQN or module path" }
      }
    },
    "Symbol": {
      "type": "object",
      "required": ["name", "kind", "path", "qualified_name"],
      "properties": {
        "name": { "type": "string", "description": "Short symbol name" },
        "kind": {
          "type": "string",
          "enum": ["module", "namespace", "class", "interface", "enum", "function", "method", "property", "field", "variable"],
          "description": "Symbol type"
        },
        "path": { "type": "string", "description": "POSIX path of containing file" },
        "qualified_name": { "type": "string", "description": "Unique symbol path within the project" },
        "parent_qualified_name": { "type": "string", "description": "Parent qualified_name (class for method)" },
        "signature": { "type": "string", "description": "Method/function signature (truncated)" },
        "location": { "$ref": "#/$defs/Location" },
        "refs": {
          "type": "array",
          "description": "Outgoing symbol connections (imports/inherits on type/class)",
          "items": { "$ref": "#/$defs/SymbolRef" }
        }
      }
    }
  }
}
