{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ods.local/ods-help/json-model/native-compose",
  "title": "Native Model — compose parser",
  "description": "parser_id=compose, schema_version=1. Native extract from docker-compose*.yml.",
  "implementation_status": "done",
  "spec": "009-system-landscape",
  "type": "object",
  "required": ["services", "infrastructure"],
  "properties": {
    "compose_file": {
      "type": "string",
      "description": "POSIX-path to processed compose-file in WC"
    },
    "services": {
      "type": "array",
      "description": "Deployable services from section services compose",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Service key in docker-compose (api, worker, …)"
          },
          "dockerfile": {
            "type": "string",
            "description": "Path to Dockerfile from build.dockerfile; nullable"
          },
          "ports": {
            "type": "array",
            "description": "Port forwarding list host:container",
            "items": {
              "type": "string",
              "description": "Port string, e.g., 22829:5003"
            }
          },
          "profiles": {
            "type": "array",
            "description": "Compose profiles, where the service is started",
            "items": {
              "type": "string",
              "description": "Name profile, e.g. all, user"
            }
          },
          "depends_on": {
            "type": "array",
            "description": "Service dependencies from depends_on",
            "items": {
              "type": "object",
              "required": ["service"],
              "properties": {
                "service": {
                  "type": "string",
                  "description": "Service name-dependency"
                },
                "condition": {
                  "type": "string",
                  "description": "Readiness condition: service_started, service_healthy, …"
                }
              }
            }
          },
          "environment": {
            "type": "array",
            "description": "Container environment variables (without exposing secrets from .env)",
            "items": {
              "type": "object",
              "required": ["key"],
              "properties": {
                "key": {
                  "type": "string",
                  "description": "Variable name, e.g. ConnectionStrings__DefaultConnection"
                },
                "value": {
                  "type": "string",
                  "description": "Value or ${VAR}; passwords are masked"
                }
              }
            }
          }
        }
      }
    },
    "infrastructure": {
      "type": "array",
      "description": "Infrastructure containers: rabbit, redis, postgres, kafka, …",
      "items": {
        "type": "object",
        "required": ["name", "kind"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Infrastructure service name in compose"
          },
          "kind": {
            "type": "string",
            "enum": ["broker", "database", "cache", "storage", "search"],
            "description": "Infrastructure component class for canon kind=broker|database|storage"
          },
          "image": {
            "type": "string",
            "description": "Docker image, e.g. rabbitmq:3-management, postgres:15.3"
          }
        }
      }
    }
  }
}
