{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ods.local/ods-help/json-model/canonical-edge-code",
  "title": "Canonical Graph Edge — Code Layer",
  "description": "Document in index Elasticsearch ods-graph-edges for code-layer: ES _id = {analysis_run_id}:{id}.",
  "implementation_status": "done",
  "implementation_note": "imports/inherits/implements/calls/injects — 008; references — reserved",
  "spec": "006-project-graph / 008-code-graph-depth",
  "type": "object",
  "required": ["id", "project_id", "analysis_run_id", "parser_id", "language", "from", "to", "type", "ingested_at"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable id edges. Format: {parser_id}:{path}:{type}:{from}:{to}"
    },
    "project_id": {
      "$ref": "_shared.schema.json#/$defs/ProjectId"
    },
    "analysis_run_id": {
      "$ref": "_shared.schema.json#/$defs/AnalysisRunId"
    },
    "parser_id": {
      "type": "string",
      "description": "Module-parser that created the edge: typescript, csharp, python, cpp"
    },
    "language": {
      "type": "string",
      "description": "Edge context language: typescript, csharp, python, cpp"
    },
    "from": {
      "type": "string",
      "description": "id canonical node-source (ods-graph-nodes.id)"
    },
    "to": {
      "type": "string",
      "description": "id canonical node-targets (ods-graph-nodes.id)"
    },
    "type": {
      "type": "string",
      "enum": ["imports", "exports", "calls", "inherits", "implements", "references", "contains", "injects"],
      "description": "Connection type code-layer: calls/injects — 008"
    },
    "path": {
      "type": "string",
      "description": "POSIX-file path where link is recorded (edge context)"
    },
    "location": {
      "$ref": "_shared.schema.json#/$defs/Location",
      "description": "Position in file path, where the connection arose; nullable"
    },
    "metadata": {
      "type": "object",
      "description": "Schema-less extensions. Recommended metadata.layer=code",
      "additionalProperties": true
    },
    "ingested_at": {
      "$ref": "_shared.schema.json#/$defs/IngestedAt"
    }
  }
}
