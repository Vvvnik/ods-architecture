{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ods.local/ods-help/json-model/canonical-edge-system",
  "title": "Canonical Graph Edge — System Layer",
  "description": "Document in index Elasticsearch ods-graph-edges for system-layer (009). Same index as ES _id = {analysis_run_id}:{id}.",
  "implementation_status": "done",
  "spec": "009-system-landscape",
  "type": "object",
  "required": ["id", "project_id", "analysis_run_id", "parser_id", "language", "from", "to", "type", "ingested_at"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable id edges system-service script ( ingest-adapter"
    },
    "project_id": { "$ref": "_shared.schema.json#/$defs/ProjectId" },
    "analysis_run_id": { "$ref": "_shared.schema.json#/$defs/AnalysisRunId" },
    "parser_id": {
      "type": "string",
      "description": "Module-parser-source: compose, openapi, bus-kafka, bus-rabbit, appsettings, …"
    },
    "language": {
      "type": "string",
      "description": "Source type/language: infra, csharp, yaml, json"
    },
    "from": {
      "type": "string",
      "description": "id node-source (system or code layer)"
    },
    "to": {
      "type": "string",
      "description": "id node-targets (system or code layer)"
    },
    "type": {
      "type": "string",
      "enum": ["depends_on", "project_reference", "http_calls", "exposes", "publishes", "consumes", "connects_to", "rpc_handles", "documents"],
      "description": "Architectural connection type system-layer"
    },
    "path": {
      "type": "string",
      "description": "POSIX-source path config/code file where the link is recorded"
    },
    "location": {
      "$ref": "_shared.schema.json#/$defs/Location",
      "description": "Position in path; nullable"
    },
    "metadata": {
      "type": "object",
      "description": "Extensions: topic, queue, http_method, connection_name, layer=system",
      "additionalProperties": true
    },
    "ingested_at": { "$ref": "_shared.schema.json#/$defs/IngestedAt" }
  }
}
