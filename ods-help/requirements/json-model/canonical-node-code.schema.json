{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ods.local/ods-help/json-model/canonical-node-code",
  "title": "Canonical Graph Node — Code Layer",
  "description": "Document in index Elasticsearch ods-graph-nodes for code-layer (009). ES _id = {analysis_run_id}:{id}.",
  "implementation_status": "implemented",
  "spec": "006-project-graph",
  "type": "object",
  "required": ["id", "project_id", "analysis_run_id", "parser_id", "kind", "name", "language", "path", "ingested_at"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable id node format: {parser_id}:{path}:{kind}:{qualified_name}"
    },
    "project_id": { "$ref": "_shared.schema.json#/$defs/ProjectId" },
    "analysis_run_id": { "$ref": "_shared.schema.json#/$defs/AnalysisRunId" },
    "parser_id": {
      "type": "string",
      "description": "Module-parser-source: typescript, csharp, python, cpp"
    },
    "kind": {
      "type": "string",
      "enum": ["file", "module", "namespace", "class", "interface", "function", "method", "property", "field", "variable", "enum"],
      "description": "Entity type code-layer as others"
    },
    "name": {
      "type": "string",
      "description": "Short symbol name for UI and full-text search"
    },
    "qualified_name": {
      "type": "string",
      "description": "Full symbol name (FQN); belongs to id node"
    },
    "language": {
      "type": "string",
      "description": "Source language: typescript, csharp, python, cpp"
    },
    "path": {
      "type": "string",
      "description": "POSIX-file path in working copy; link to ods-elements (002)"
    },
    "location": {
      "$ref": "_shared.schema.json#/$defs/Location",
      "description": "Row/column range of character in path; nullable"
    },
    "element_id": {
      "type": "string",
      "format": "uuid",
      "description": "FK → document ods-elements (file tree 002); nullable if not mapped"
    },
    "parent_id": {
      "type": "string",
      "description": "id parent node in the canon (class for method); nullable for the root"
    },
    "signature": {
      "type": "string",
      "description": "Signature method/function for display; nullable"
    },
    "metadata": {
      "type": "object",
      "description": "Schema-less extensions. Recommended metadata.layer=code",
      "additionalProperties": true
    },
    "ingested_at": { "$ref": "_shared.schema.json#/$defs/IngestedAt" }
  }
}
