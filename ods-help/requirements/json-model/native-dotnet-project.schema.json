{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ods.local/ods-help/json-model/native-dotnet-project",
  "title": "Native Model — dotnet-project parser",
  "description": "parser_id=dotnet-project, schema_version=1. .sln and ProjectReference graph.",
  "implementation_status": "done",
  "spec": "009-system-landscape",
  "type": "object",
  "required": ["projects"],
  "properties": {
    "solutions": {
      "type": "array",
      "description": "Visual Studio solutions (.sln) in detector, repo",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "POSIX-path to .sln file"
          },
          "name": {
            "type": "string",
            "description": "Name solution without extension: Sample, WebApplication1"
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "description": "All.csproj and their ProjectReference connection",
      "items": {
        "type": "object",
        "required": ["path", "name"],
        "properties": {
          "path": {
            "type": "string",
            "description": "POSIX-path to .csproj"
          },
          "name": {
            "type": "string",
            "description": "Name project file: Sample.Api.csproj"
          },
          "project_type": {
            "type": "string",
            "enum": ["web", "classlib", "worker", "test", "unknown"],
            "description": "Project type heuristic by Sdk/OutputType"
          },
          "service_folder_hint": {
            "type": "string",
            "description": "Folder deployable service: api, worker, …"
          },
          "references": {
            "type": "array",
            "description": "ProjectReference → other csproj (ribs project_reference)",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "description": "Relative POSIX-path target .csproj"
                },
                "name": {
                  "type": "string",
                  "description": "Name target project file"
                }
              }
            }
          },
          "package_references": {
            "type": "array",
            "description": "NuGet PackageReference id (optionally in version",
            "items": {
              "type": "string",
              "description": "Package id: Microsoft.AspNetCore.Mvc, MassTransit.Kafka, …"
            }
          }
        }
      }
    }
  }
}
