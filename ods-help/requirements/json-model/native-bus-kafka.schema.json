{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ods.local/ods-help/json-model/native-bus-kafka",
  "title": "Native Model — bus-kafka parser",
  "description": "parser_id=bus-kafka, schema_version=1. Kafka + MassTransit consumers/publishers.",
  "implementation_status": "done",
  "spec": "009-system-landscape",
  "type": "object",
  "required": ["handlers"],
  "properties": {
    "service_hint": {
      "type": "string",
      "description": "Logical service from path or namespace: Sample.Api, Sample.Worker, …"
    },
    "handlers": {
      "type": "array",
      "description": "Consumer/producer worker classes and MassTransit handlers",
      "items": {
        "type": "object",
        "required": ["path", "role"],
        "properties": {
          "path": {
            "type": "string",
            "description": "POSIX-path to file worker/handler"
          },
          "class_name": {
            "type": "string",
            "description": "Name C# class handler, e.g. OrderConsumerWorker"
          },
          "role": {
            "type": "string",
            "enum": ["consumer", "producer", "both"],
            "description": "Role handler regarding Kafka topic"
          },
          "topic": {
            "type": "string",
            "description": "Name Kafka topic if known from literal or resolved config"
          },
          "topic_config_key": {
            "type": "string",
            "description": "Key appsettings for the name topic, if topic not literal"
          },
          "message_type": {
            "type": "string",
            "description": "CLR type name or schema name payload messages"
          },
          "group_id": {
            "type": "string",
            "description": "Kafka consumer group id; nullable"
          }
        }
      }
    },
    "publish_sites": {
      "type": "array",
      "description": "Publish locations via IBusMessagePublisher.Publish or alternative",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Call file Publish"
          },
          "method": {
            "type": "string",
            "description": "Method name C#, containing Publish"
          },
          "topic": {
            "type": "string",
            "description": "Name topic argument Publish"
          },
          "message_type": {
            "type": "string",
            "description": "Published message type"
          }
        }
      }
    }
  }
}
