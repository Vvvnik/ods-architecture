{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ods.local/ods-help/json-model/native-dotnet-api-routes",
  "title": "Native Model — dotnet-api-routes parser",
  "description": "parser_id=dotnet-api-routes, schema_version=1. ASP.NET routes + HTTP client registration.",
  "implementation_status": "planned",
  "spec": "008-code-graph-depth / 009-system-landscape",
  "type": "object",
  "required": ["controllers", "http_clients"],
  "properties": {
    "controllers": {
      "type": "array",
      "description": "ASP.NET Core controllers with Route/Http* attributes",
      "items": {
        "type": "object",
        "required": ["path", "class_name", "routes"],
        "properties": {
          "path": {
            "type": "string",
            "description": "POSIX-path to controller file"
          },
          "class_name": {
            "type": "string",
            "description": "Name C# controller class"
          },
          "base_route": {
            "type": "string",
            "description": "Template [Route] on class, e.g. api/v1/weather"
          },
          "routes": {
            "type": "array",
            "description": "HTTP endpoints controller",
            "items": {
              "type": "object",
              "required": ["http_method", "route_template"],
              "properties": {
                "http_method": {
                  "type": "string",
                  "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"],
                  "description": "HTTP verb from HttpGet/HttpPost/… attribute"
                },
                "route_template": {
                  "type": "string",
                  "description": "Template route action: get-data, {id:guid}/upload, …"
                },
                "full_path": {
                  "type": "string",
                  "description": "Built URL path: api/v1/weather/forecast"
                },
                "action_method": {
                  "type": "string",
                  "description": "Name C# action method"
                },
                "location": {
                  "type": "object",
                  "description": "Row range action in the controller file",
                  "properties": {
                    "start_line": {
                      "type": "integer",
                      "description": "First line action (1-based)"
                    },
                    "end_line": {
                      "type": "integer",
                      "description": "End line action (1-based)"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "http_clients": {
      "type": "array",
      "description": "Registration of outgoing HTTP/gRPC clients (Refit, HttpClient, …)",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Registration file: Startup.cs, AutofacModule.cs, Program.cs, …"
          },
          "client_type": {
            "type": "string",
            "enum": ["refit", "httpclient", "grpc"],
            "description": "Technology HTTP client"
          },
          "interface": {
            "type": "string",
            "description": "Interface Refit/gRPC client: IUserCredentialsRestApi, …"
          },
          "base_url": {
            "type": "string",
            "description": "BaseAddress or URL literal: http://worker/…, https://api.example.com"
          },
          "target_service_hint": {
            "type": "string",
            "description": "Target service or external: worker, external:payments, …"
          }
        }
      }
    }
  }
}
