{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ods.local/ods-help/json-model/native-catalog-info",
  "title": "Native Model — catalog-info parser",
  "description": "parser_id=catalog-info, schema_version=1. Backstage catalog-info.yaml entities.",
  "implementation_status": "planned",
  "spec": "009-system-landscape",
  "type": "object",
  "required": ["entities"],
  "properties": {
    "entities": {
      "type": "array",
      "description": "Сущности Backstage из одного или нескольких catalog-info.yaml",
      "items": {
        "type": "object",
        "required": ["apiVersion", "kind", "metadata"],
        "properties": {
          "apiVersion": {
            "type": "string",
            "description": "Версия Backstage API, напр. backstage.io/v1alpha1"
          },
          "kind": {
            "type": "string",
            "enum": ["System", "Component", "API", "Resource", "Location"],
            "description": "Тип сущности Backstage catalog"
          },
          "metadata": {
            "type": "object",
            "description": "Метаданные сущности Backstage",
            "properties": {
              "name": {
                "type": "string",
                "description": "Уникальное имя сущности в catalog"
              },
              "description": {
                "type": "string",
                "description": "Человекочитаемое описание system/component"
              },
              "tags": {
                "type": "array",
                "description": "Теги для фильтрации в Backstage/ODS",
                "items": {
                  "type": "string",
                  "description": "Один tag, напр. platform, core"
                }
              }
            }
          },
          "spec": {
            "type": "object",
            "description": "Спецификация сущности Backstage",
            "properties": {
              "owner": {
                "type": "string",
                "description": "Владелец сущности в catalog (team/group)"
              },
              "dependsOn": {
                "type": "array",
                "description": "Ссылки на другие catalog entities: resource:postgres, component:api, …",
                "items": {
                  "type": "string",
                  "description": "Строка ссылки kind:name"
                }
              },
              "type": {
                "type": "string",
                "description": "Тип Component: service, website, library, …"
              },
              "lifecycle": {
                "type": "string",
                "description": "Стадия жизненного цикла: production, experimental, …"
              }
            }
          },
          "source_path": {
            "type": "string",
            "description": "POSIX-путь к yaml-файлу catalog-info в repo"
          }
        }
      }
    }
  }
}
