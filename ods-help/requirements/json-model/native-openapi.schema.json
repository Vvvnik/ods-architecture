{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ods.local/ods-help/json-model/native-openapi",
  "title": "Native Model — openapi parser",
  "description": "parser_id=openapi, schema_version=1. OpenAPI/Swagger YAML from contracts/ and **/openapi*.yaml.",
  "implementation_status": "done",
  "spec": "009-system-landscape",
  "type": "object",
  "required": ["specs"],
  "properties": {
    "specs": {
      "type": "array",
      "description": "Processed list OpenAPI spec files",
      "items": {
        "type": "object",
        "required": ["path", "endpoints"],
        "properties": {
          "path": {
            "type": "string",
            "description": "POSIX-path to yaml spec in detector, WC"
          },
          "title": {
            "type": "string",
            "description": "info.title from OpenAPI document"
          },
          "service_hint": {
            "type": "string",
            "description": "Logical service from path or x- extension: Sample.Api, billing, …"
          },
          "endpoints": {
            "type": "array",
            "description": "REST operations from paths section",
            "items": {
              "type": "object",
              "required": ["method", "path"],
              "properties": {
                "method": {
                  "type": "string",
                  "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"],
                  "description": "HTTP method operation"
                },
                "path": {
                  "type": "string",
                  "description": "URL path template: /api/v1/plans/{planId}"
                },
                "operation_id": {
                  "type": "string",
                  "description": "OpenAPI operationId; nullable"
                },
                "summary": {
                  "type": "string",
                  "description": "Short description operation; nullable"
                },
                "tags": {
                  "type": "array",
                  "description": "OpenAPI tags operation",
                  "items": {
                    "type": "string",
                    "description": "Name tag: weather, billing, …"
                  }
                }
              }
            }
          },
          "message_schemas": {
            "type": "array",
            "description": "Async/Kafka message schemas from components or *_kafka_fake.yaml",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Name schema / message type in detector, spec"
                },
                "topic_hint": {
                  "type": "string",
                  "description": "Kafka topic name if specified in spec or filename"
                }
              }
            }
          }
        }
      }
    }
  }
}
