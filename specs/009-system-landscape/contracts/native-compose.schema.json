{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ods.local/ods-help/json-model/native-compose",
  "title": "Native Model — compose parser",
  "description": "parser_id=compose, schema_version=1. Native extract from docker-compose*.yml.",
  "implementation_status": "planned",
  "spec": "009-system-landscape",
  "type": "object",
  "required": ["services", "infrastructure"],
  "properties": {
    "compose_file": {
      "type": "string",
      "description": "POSIX-way to the treated compose-file WC"
    },
    "services": {
      "type": "array",
      "description": "Deployable services from the section services compose",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Service key in docker-compose (api, worker, ...)"
          },
          "dockerfile": {
            "type": "string",
            "description": "Path Dockerfile from build.dockerfile; nullable"
          },
          "ports": {
            "type": "array",
            "description": "Port forwarding list host:container",
            "items": {
              "type": "string",
              "description": "Port string, e.g. 22829:5003"
            }
          },
          "profiles": {
            "type": "array",
            "description": "Compose profiles, at which the service increases",
            "items": {
              "type": "string",
              "description": "Name profile, eg. all, user"
            }
          },
          "depends_on": {
            "type": "array",
            "description": "Service dependencies from depends_on",
            "items": {
              "type": "object",
              "required": ["service"],
              "properties": {
                "service": {
                  "type": "string",
                  "description": "Dependency Service Name"
                },
                "condition": {
                  "type": "string",
                  "description": "Ready condition: service_started, service_healthy, ..."
                }
              }
            }
          },
          "environment": {
            "type": "array",
            "description": "Container environment variables (without disclosing secrets from .env)",
            "items": {
              "type": "object",
              "required": ["key"],
              "properties": {
                "key": {
                  "type": "string",
                  "description": "Variable name, e.g. ConnectionStrings__DefaultConnection"
                },
                "value": {
                  "type": "string",
                  "description": "The value or ${VAR}; passwords are masked"
                }
              }
            }
          }
        }
      }
    },
    "infrastructure": {
      "type": "array",
      "description": "Infrastructure containers: rabbit, redis, postgres, kafka, ...",
      "items": {
        "type": "object",
        "required": ["name", "kind"],
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the infrastructure service in compose"
          },
          "kind": {
            "type": "string",
            "enum": ["broker", "database", "cache", "storage", "search"],
            "description": "Class infrastructural component for Canon kind=broker|database|storage"
          },
          "image": {
            "type": "string",
            "description": "Docker image, eg. rabbitmq:3-management, postgres:15.3"
          }
        }
      }
    }
  }
}
