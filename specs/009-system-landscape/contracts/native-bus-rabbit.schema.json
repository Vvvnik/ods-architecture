{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ods.local/ods-help/json-model/native-bus-rabbit",
  "title": "Native Model — bus-rabbit parser",
  "description": "parser_id=bus-rabbit, schema_version=1. RabbitMQ listeners and message handlers.",
  "implementation_status": "planned",
  "spec": "009-system-landscape",
  "type": "object",
  "required": ["handlers"],
  "properties": {
    "service_hint": {
      "type": "string",
      "description": "Logical service: api, worker, billing ... from the path or config"
    },
    "handlers": {
      "type": "array",
      "description": "Subscription queue listener and dedicated handlers",
      "items": {
        "type": "object",
        "required": ["path", "role", "message_type"],
        "properties": {
          "path": {
            "type": "string",
            "description": "POSIX-path to listener/handler file"
          },
          "listener_class": {
            "type": "string",
            "description": "The class name is listener, e.g. QueueListener"
          },
          "handler_method": {
            "type": "string",
            "description": "Method name handler: OnOrderCreated, ..."
          },
          "role": {
            "type": "string",
            "enum": ["consumer", "producer", "rpc_handler", "rpc_client"],
            "description": "The role handler: consume message, publish, RPC server/client"
          },
          "message_type": {
            "type": "string",
            "description": "Generic type posts: OrderCreatedMessage, GetCustomerRequest, …"
          },
          "queue_hint": {
            "type": "string",
            "description": "Name queue if extracted from convention/shared lib; nullable"
          },
          "exchange_hint": {
            "type": "string",
            "description": "Name exchange if known; nullable"
          }
        }
      }
    },
    "rpc_services": {
      "type": "array",
      "description": "RPC service implementations (IRpc*Service)",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "POSIX-implementation file path RPC service"
          },
          "interface": {
            "type": "string",
            "description": "Interface name: ICustomerQueryService, ..."
          },
          "implementation": {
            "type": "string",
            "description": "Implementation class name: CustomerQueryService, ..."
          },
          "operations": {
            "type": "array",
            "description": "RPC operations interface/implementation",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Operation method name: GetById, ..."
                },
                "request_type": {
                  "type": "string",
                  "description": "Type request DTO: GetCustomerRequest"
                },
                "response_type": {
                  "type": "string",
                  "description": "Type response DTO: GetCustomerResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}
