{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ods.local/specs/019/native-java-api-routes",
  "title": "Native Model — java-api-routes",
  "description": "parser_id=java-api-routes, schema_version=1. Spring MVC/WebFlux routes from code; Gateway optional.",
  "type": "object",
  "required": ["routes"],
  "additionalProperties": true,
  "properties": {
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["method", "path", "source_path"],
        "additionalProperties": true,
        "properties": {
          "method": { "type": "string", "description": "HTTP method UPPER" },
          "path": {
            "type": "string",
            "description": "Full HTTP path when statically known"
          },
          "source_path": { "type": "string" },
          "handler_name": { "type": ["string", "null"] },
          "service_hint": { "type": ["string", "null"] },
          "path_complete": { "type": "boolean" },
          "route_kind": {
            "type": ["string", "null"],
            "description": "mvc | webflux | gateway"
          }
        }
      }
    }
  }
}
