{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ods.local/ods-help/json-model/native-symbols-v2",
  "title": "Native Symbols Model v2",
  "description": "Extension v1: usages (calls, injects in MVP). Canon contracts 008-code-graph-depth. backward compatible through schema_version.",
  "implementation_status": "done",
  "spec": "008-code-graph-depth",
  "mvp_usage_types": ["calls", "injects"],
  "type": "object",
  "required": ["symbols"],
  "properties": {
    "symbols": {
      "type": "array",
      "description": "How v1 for symbols[].refs; semantics MVP 008 (calls/injects) — in usages[], not refs",
      "items": { "$ref": "native-symbols-v1.schema.json#/$defs/Symbol" }
    },
    "usages": {
      "type": "array",
      "description": "Optional: separate array of semantic usages (alternative refs on symbol)",
      "items": { "$ref": "#/$defs/Usage" }
    }
  },
  "$defs": {
    "Usage": {
      "type": "object",
      "required": ["from", "to", "type"],
      "properties": {
        "from": { "type": "string", "description": "qualified_name or logical id source (method/function)" },
        "to": { "type": "string", "description": "qualified_name or logical id goals" },
        "type": {
          "type": "string",
          "enum": ["calls", "references", "creates", "injects", "reads", "writes"],
          "description": "Semantic type usage"
        },
        "path": { "type": "string", "description": "The file where ⟪usage is recorded" },
        "location": { "$ref": "native-symbols-v1.schema.json#/$defs/Location" },
        "metadata": {
          "type": "object",
          "description": "For example: inject_param_name, call_expression_text",
          "additionalProperties": true
        }
      }
    }
  }
}
