{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ods.local/ods-help/json-model/native-symbols-v1",
  "title": "Native Symbols Model v1",
  "description": "Native model for typescript, csharp, python, cpp (schema_version 1). Implemented in parsers/*.",
  "implementation_status": "implemented",
  "spec": "005-code-analysis / 006-project-graph",
  "type": "object",
  "required": ["symbols"],
  "properties": {
    "symbols": {
      "type": "array",
      "description": "A flat list of file characters and nested entities",
      "items": { "$ref": "#/$defs/Symbol" }
    }
  },
  "$defs": {
    "Location": {
      "type": "object",
      "description": "Position in the source (1-based line)",
      "properties": {
        "start_line": { "type": "integer", "minimum": 1, "description": "The initial line" },
        "start_col": { "type": "integer", "minimum": 0, "description": "The initial column" },
        "end_line": { "type": "integer", "minimum": 1, "description": "The final line" },
        "end_col": { "type": "integer", "minimum": 0, "description": "The final column" }
      }
    },
    "SymbolRef": {
      "type": "object",
      "description": "A link from a character to another character or namespace",
      "required": ["type", "name"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["imports", "exports", "inherits", "implements"],
          "description": "Type of communication native model v1 (calls — only v2)"
        },
        "name": { "type": "string", "description": "The short name of the goal" },
        "kind": { "type": "string", "description": "kind goals, if known" },
        "path": { "type": "string", "description": "POSIX-the path of the target file, if allowed" },
        "qualified_name": { "type": "string", "description": "FQN or module path goals" }
      }
    },
    "Symbol": {
      "type": "object",
      "required": ["name", "kind", "path", "qualified_name"],
      "properties": {
        "name": { "type": "string", "description": "The short name of the symbol" },
        "kind": {
          "type": "string",
          "enum": ["module", "namespace", "class", "interface", "enum", "function", "method", "property", "field", "variable"],
          "description": "Character Type"
        },
        "path": { "type": "string", "description": "POSIX-media file path" },
        "qualified_name": { "type": "string", "description": "The unique path of the symbol within the project" },
        "parent_qualified_name": { "type": "string", "description": "qualified_name parent (class for method)" },
        "signature": { "type": "string", "description": "Method/function signature (cropped)" },
        "location": { "$ref": "#/$defs/Location" },
        "refs": {
          "type": "array",
          "description": "Output symbol (imports/inherits on type/class)",
          "items": { "$ref": "#/$defs/SymbolRef" }
        }
      }
    }
  }
}
