{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ods.local/ods-help/json-model/_shared",
  "title": "ODS JSON Model - common types",
  "description": "Reused fragments for $ref from other *.schema.json in this folder.",
  "$defs": {
    "Location": {
      "type": "object",
      "description": "The position in the source file or config (lines with 1)",
      "properties": {
        "start_line": { "type": "integer", "minimum": 1, "description": "Initial string (1-based)" },
        "start_col": { "type": "integer", "minimum": 0, "description": "Initial column (0-based)" },
        "end_line": { "type": "integer", "minimum": 1, "description": "The final string (1-based)" },
        "end_col": { "type": "integer", "minimum": 0, "description": "End column (0-based)" }
      }
    },
    "ProjectId": {
      "type": "string",
      "format": "uuid",
      "description": "UUID project ODS (FK → ods-projects, SPECA 002)"
    },
    "AnalysisRunId": {
      "type": "string",
      "format": "uuid",
      "description": "UUID analysis run; all nodes/edges of one graph snapshot"
    },
    "IngestedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC; the recording of the document ingest-nipeline (006)"
    }
  }
}
