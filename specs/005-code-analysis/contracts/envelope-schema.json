{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ods.local/schemas/parser-envelope/v1",
  "title": "Parser Envelope",
  "description": "Common language parser output contract (005). The model field is not validated by the orchestrator.",
  "type": "object",
  "required": [
    "parser_id",
    "schema_version",
    "project_id",
    "analysis_run_id",
    "generated_at",
    "files_analyzed",
    "model"
  ],
  "additionalProperties": false,
  "properties": {
    "parser_id": {
      "type": "string",
      "description": "Matches the manifest.json id",
      "examples": ["typescript", "python"]
    },
    "schema_version": {
      "type": "string",
      "description": "Native version of JSON inside the model",
      "examples": ["1"]
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "analysis_run_id": {
      "type": "string",
      "format": "uuid"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "files_analyzed": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Way relative to working_copy_root, POSIX"
      },
      "minItems": 0
    },
    "model": {
      "description": "Free native extract; the schema is defined by parser_id + schema_version"
    }
  }
}
