# ODS MVP development stack (002 backend + 003 frontend)
# Copy with: cp docker/.env.example docker/.env

# Docker Compose project name (containers: ods-mvp-elasticsearch-1, …).
# Separates ODS from other Compose projects in the docker/ directory (asciidoc, etc.).
COMPOSE_PROJECT_NAME=ods-mvp

# --- Elasticsearch + backend (002) ---
ELASTICSEARCH_URL=http://elasticsearch:9200
DATA_ROOT=/data/ods
LOCAL_REPOS_MOUNT=/repos
PORT=3000
GIT_CLONE_DEPTH=1

# --- Code analysis (005 / 026 scale knobs) ---
PARSERS_ROOT=/app/parsers
ANALYSIS_PARSER_TIMEOUT_MS=600000
# Max concurrent parser jobs (default 4 since 026; raise on large multi-core hosts).
ANALYSIS_MAX_PARALLEL_PARSERS=4
# Max files per parser chunk (tiny last chunks are merged when <10% of this size).
ANALYSIS_PARSER_FILE_CHUNK_SIZE=500
# Docker full: true — fail if Release DLL/JAR missing (no silent dotnet run / mvn).
# Bare local: false — allows local fallback builds for parser authors.
ANALYSIS_REQUIRE_PREBUILT=true

# Host path mounted at backend:/repos:ro
# Prefer an ABSOLUTE host path so Import accepts the same path as on disk, e.g.:
#   LOCAL_REPOS_HOST_PATH=/absolute/path/to/ods-architecture/docker/fixtures/repos
# Broader parent (fixtures + other local trees under one mount):
#   LOCAL_REPOS_HOST_PATH=/absolute/path/to/parent
# Windows (forward slashes OK; backslashes OK in .env):
#   LOCAL_REPOS_HOST_PATH=C:/Users/you/ods-architecture/docker/fixtures/repos
LOCAL_REPOS_HOST_PATH=./fixtures/repos

# Optional extra mount → /repos-extra (pair with LOCAL_PATH_MAP).
# LOCAL_PATH_MAP uses host:container; split is on ":/" so Windows drives work:
#   LOCAL_REPOS_EXTRA_HOST_PATH=C:/Users/you/code
#   LOCAL_PATH_MAP=C:/Users/you/code:/repos-extra
# LOCAL_REPOS_EXTRA_HOST_PATH=/absolute/path/to/other-repos
# LOCAL_PATH_MAP=/absolute/path/to/other-repos:/repos-extra

# --- Frontend (003) — optional in Compose; nginx proxies /api ---
# FRONTEND_PORT=8080
