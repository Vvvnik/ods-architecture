# Dev-стек ODS MVP (002 backend + 003 frontend)
# Скопировать: cp docker/.env.example docker/.env

# Имя проекта Docker Compose (контейнеры: ods-mvp-elasticsearch-1, …).
# Отделяет ODS от других compose в каталоге docker/ (asciidoc и т.д.).
COMPOSE_PROJECT_NAME=ods-mvp

# --- Elasticsearch + backend (002) ---
ELASTICSEARCH_URL=http://elasticsearch:9200
DATA_ROOT=/data/ods
LOCAL_REPOS_MOUNT=/repos
PORT=3000
GIT_CLONE_DEPTH=1

# Путь на хосте к тестовым git-репозиториям (mount в backend:/repos:ro)
LOCAL_REPOS_HOST_PATH=./fixtures/repos

# --- Frontend (003) — в compose не обязателен; nginx проксирует /api ---
# FRONTEND_PORT=8080
