# ODS MVP development stack (002 backend + 003 frontend)
# Copy with: cp docker/.env.example docker/.env

# Docker Compose project name (containers: ods-mvp-elasticsearch-1, …).
# Separates ODS from other Compose projects in the docker/ directory (asciidoc, etc.).
COMPOSE_PROJECT_NAME=ods-mvp

# --- Elasticsearch + backend (002) ---
ELASTICSEARCH_URL=http://elasticsearch:9200
DATA_ROOT=/data/ods
LOCAL_REPOS_MOUNT=/repos
PORT=3000
GIT_CLONE_DEPTH=1

# --- Code analysis (005) ---
PARSERS_ROOT=/app/parsers
ANALYSIS_PARSER_TIMEOUT_MS=600000

# Host path to test Git repositories (mounted at backend:/repos:ro)
LOCAL_REPOS_HOST_PATH=./fixtures/repos

# --- Frontend (003) — optional in Compose; nginx proxies /api ---
# FRONTEND_PORT=8080
